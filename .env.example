# Copy to backend/.env. Never put actual secrets in this tracked template.
# Create a Gemini key at https://aistudio.google.com/apikey.
# Use a free-tier Google project with billing disabled to avoid paid usage.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted; GEMINI_API_KEY takes precedence.
TAVILY_API_KEY=
GEMINI_MODEL=auto
DATA_DIR=./data
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=20
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Use the SAME Clerk application as the Next.js server.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

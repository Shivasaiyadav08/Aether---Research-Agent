# Copy this file to backend/.env. Keys never go into the frontend.
GEMINI_MODEL=
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MAX_MODEL_ATTEMPTS=3
GEMINI_OPERATION_TIMEOUT_SECONDS=75
GEMINI_STRUCTURED_MAX_OUTPUT_TOKENS=2048
DATA_DIR=
FRONTEND_ORIGIN=
MAX_UPLOAD_MB=
EMBEDDING_MODEL=
CLERK_AUTHORIZED_PARTIES=
CLERK_SECRET_KEY=
CLERK_ISSUER=
ENVIRONMENT=development
GEMINI_PROJECT_ID=local
# Set true only after confirming the Gemini project has billing disabled.
GEMINI_FREE_PROJECT_CONFIRMED=false
GEMINI_FREE_RPM=5
GEMINI_FREE_RPD=20
GEMINI_FREE_TPM=125000
GEMINI_MAX_CONCURRENCY=2
RESEARCH_TIMEOUT_SECONDS=240
MAX_RESEARCH_JOBS=2
USER_REQUESTS_PER_MINUTE=120
# For production: mount a durable disk and keep DATA_DIR below this mount.
PERSISTENT_DATA_ROOT=
# Optional shared PostgreSQL and external Chroma for multiple backend instances.
DATABASE_URL=
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=true
CHROMA_AUTH_TOKEN=

# Render Free + Supabase. Set these in Render Environment; never commit backend/.env.
# Run supabase/setup.sql in Supabase SQL Editor first. See docs/supabase-deployment.md.
ENVIRONMENT=production
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
# Set true only after confirming billing is disabled on this Google project.
GEMINI_FREE_PROJECT_CONFIRMED=false
EMBEDDING_PROVIDER=gemini
CLERK_SECRET_KEY=
CLERK_ISSUER=
FRONTEND_ORIGIN=https://crebry-research-agent.vercel.app
CLERK_AUTHORIZED_PARTIES=https://crebry-research-agent.vercel.app
# Supabase Connect -> Session pooler. Percent-encode reserved characters in the password.
DATABASE_URL=
VECTOR_PROVIDER=supabase
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=crebry-documents
# Only temporary upload processing uses this directory in Supabase mode.
DATA_DIR=/var/data/crebry
# Optional: web research; omit to research uploaded documents only.
TAVILY_API_KEY=
